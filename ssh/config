# ============================================
# Raspberry Pi Pattern Matching
# ============================================

# RPi devices - use wildcard patterns for easy additions
Host rpi* pi*
    User mjb
    # Add new Pi's to known_hosts automatically during initial setup
    StrictHostKeyChecking accept-new

# ============================================
# Git Configuration
# ============================================

# Personal GitHub — uses the on-disk ed25519 key so git works headless
# (bypasses the trailing Host * 1Password-agent stanza, like Forgejo).
Host github.com github
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none
    StrictHostKeyChecking accept-new

# GitHub alias for this repo
Host mjbeatty89
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	IdentityAgent none
	StrictHostKeyChecking accept-new

# ============================================
# Forgejo (self-hosted, tailnet) — git over SSH
# ============================================
# The Forgejo image's own sshd is published on the tailnet at :2222.
# Keyring / 1Password SSH agents are bypassed here so git works
# non-interactively (opencode-synced startup sync, cron, CI runners).
Host forgejo
    HostName ai-server.manee-frog.ts.net
    User git
    Port 2222
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none
    StrictHostKeyChecking accept-new

Host *
	IdentityAgent ~/.1password/agent.sock
